# Crawlee Service Configuration
# Copy this file to .env and update the values

# Server Configuration
PORT=3001
HOST=127.0.0.1
NODE_ENV=development

# API Security
# Generate a secure key: openssl rand -hex 32
API_KEY=your-secure-api-key-here

# =============================================================================
# RESOURCE OPTIMIZATION
# =============================================================================
# Set LITE_MODE=true to disable Playwright (saves ~500MB RAM)
# Use this if you only need fast HTML scraping without JavaScript rendering
LITE_MODE=false

# Maximum memory usage (in MB) - set lower for constrained environments
# NODE_OPTIONS="--max-old-space-size=256"

# =============================================================================
# CRAWLING DEFAULTS
# =============================================================================
# Lower these values to reduce resource usage
DEFAULT_MAX_REQUESTS=50
DEFAULT_TIMEOUT_SECS=60
DEFAULT_CONCURRENCY=3

# =============================================================================
# BROWSER CONFIGURATION (Playwright)
# =============================================================================
# Set to true for server environments (recommended)
HEADLESS=true

# Timeout for browser launch (ms)
BROWSER_LAUNCH_TIMEOUT=30000

# Block resource types to speed up crawling and reduce bandwidth
# Options: image, stylesheet, font, media, script
# BLOCK_RESOURCES=image,stylesheet,font

# =============================================================================
# PROXY CONFIGURATION (optional)
# =============================================================================
# Comma-separated list of proxy URLs
# PROXY_URLS=http://proxy1:8080,http://proxy2:8080
# PROXY_ROTATION=true

# =============================================================================
# STORAGE
# =============================================================================
STORAGE_DIR=./storage
PERSIST_STORAGE=false

# =============================================================================
# LOGGING
# =============================================================================
# Options: error, warn, info, debug
LOG_LEVEL=info
