# This is an example of .env.local with placeholder values
# Copy this file to .env.local and fill in your actual values

# =============================================================================
# REQUIRED FOR LOCAL DEVELOPMENT
# =============================================================================

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Canonical site URL for server-side auth redirects in production
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
NEXT_PUBLIC_APP_NAME="Kre8iv Clients"

# Supabase (REQUIRED)
# Get these from: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Database (REQUIRED)
# Get connection string from Supabase Dashboard → Settings → Database
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxxxxxxxxxxxx.supabase.co:5432/postgres

# =============================================================================
# REQUIRED FOR PRODUCTION
# =============================================================================

# Stripe (for payments)
# Get from: https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# Resend (for emails)
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@yourdomain.com
RESEND_FROM_NAME="Kre8iv Clients"

# Inngest (for background jobs)
# Get from: https://app.inngest.com/env/production/manage/keys
INNGEST_EVENT_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
INNGEST_SIGNING_KEY=signkey-prod-xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_INNGEST_APP_ID=your-app-id

# =============================================================================
# OPTIONAL - FOR ENHANCED FEATURES
# =============================================================================

# Error Tracking (optional but recommended)
# Get from: https://sentry.io/settings/[your-org]/projects/[your-project]/keys/
SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxx@oxxxxxx.ingest.sentry.io/xxxxxxx
SENTRY_AUTH_TOKEN=sntrys_xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development

# Analytics (optional)
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=your_analytics_id

# AI Providers (only if AI features enabled)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_AI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxx

# Social Media OAuth (only if social media features enabled)
GOOGLE_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx
FACEBOOK_APP_ID=xxxxxxxxxxxxxxxx
FACEBOOK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWITTER_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
TWITTER_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LINKEDIN_CLIENT_ID=xxxxxxxxxxxxxxxx
LINKEDIN_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Cloud Storage (only if external storage features enabled)
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-bucket-name
GOOGLE_DRIVE_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_DRIVE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx
DROPBOX_APP_KEY=xxxxxxxxxxxxxxxx
DROPBOX_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================

NODE_ENV=development

# Feature Flags (can also be managed via admin panel)
NEXT_PUBLIC_ENABLE_AI_FEATURES=false
NEXT_PUBLIC_ENABLE_SOCIAL_MEDIA=false
NEXT_PUBLIC_ENABLE_BRAND_MONITORING=false
NEXT_PUBLIC_ENABLE_MARKETING_TOOLS=false
NEXT_PUBLIC_ENABLE_MAINTENANCE_PLANS=false

# =============================================================================
# INSTRUCTIONS
# =============================================================================
#
# 1. Copy this file: cp .env.local.example .env.local
# 2. Fill in REQUIRED values (Supabase, Database)
# 3. For local development, you can use test/development keys for Stripe, Resend, Inngest
# 4. For production, get production keys from each service
# 5. Never commit .env.local to git (it's in .gitignore)
#
# Minimum to get started (local dev):
#   - NEXT_PUBLIC_SUPABASE_URL
#   - NEXT_PUBLIC_SUPABASE_ANON_KEY
#   - SUPABASE_SERVICE_KEY
#   - DATABASE_URL
#
# Add payment features:
#   + STRIPE_SECRET_KEY
#   + NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY
#
# Add email features:
#   + RESEND_API_KEY
#
# Add background jobs:
#   + INNGEST_EVENT_KEY
#   + INNGEST_SIGNING_KEY
#
