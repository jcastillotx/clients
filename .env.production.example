#############################################
# Production Environment Template (NO SECRETS)
#############################################

APP_NAME="Kre8iv Designs Client Portal"
APP_ENV=production
APP_KEY=base64:REPLACE_WITH_APP_KEY
APP_DEBUG=false
APP_URL=https://clients.example.com
APP_TIMEZONE=America/New_York

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# Cloudflare / reverse-proxy support
TRUSTED_PROXIES=*

# Cookies / sessions (production recommended)
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
# Cookies / session hardening (recommended)
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Admin route hardening (recommended)
# Empty allowlist means "allow all". Set to your office/VPN IP(s) if possible.
ADMIN_IP_ALLOWLIST=
ENFORCE_ADMIN_2FA=true
AUDIT_RETENTION_DAYS=365
TWO_FACTOR_ISSUER="${APP_NAME}"

# CORS Configuration for API
# Production: Set specific allowed origins (e.g., https://yourdomain.com,https://app.yourdomain.com)
# Development: Can use * for testing
CORS_ALLOWED_ORIGINS=https://clients.example.com

# Trusted Proxies (for proper client IP detection)
# Set to * if behind Cloudflare or AWS ELB/ALB
# Or specify proxy IPs: 10.0.0.1,10.0.0.2
# Leave empty if not using proxies
TRUSTED_PROXIES=*

#################
# Database (MySQL)
#################
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=client_portal
DB_USERNAME=client_portal_user
DB_PASSWORD=REPLACE_ME

#############
# Cache/Queue
#############
# cPanel friendly defaults:
CACHE_STORE=file
QUEUE_CONNECTION=database
SESSION_DRIVER=database

# If Redis is available:
# CACHE_STORE=redis
# QUEUE_CONNECTION=redis
# SESSION_DRIVER=redis
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=null

################
# Mail (SMTP)
################
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=465
MAIL_USERNAME=REPLACE_ME
MAIL_PASSWORD=REPLACE_ME
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

############################
# Filesystem / Upload settings
############################
FILESYSTEM_DISK=local
CLIENT_PORTAL_MAX_UPLOAD_SIZE=10240
CLIENT_PORTAL_ALLOWED_FILE_TYPES=pdf,doc,docx,xls,xlsx,png,jpg,jpeg,gif,zip

#############
# AWS (S3 disk)
#############
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

###############################
# Storage Providers (OAuth apps)
###############################
# Dropbox OAuth
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REDIRECT_URI=https://clients.example.com/storage/dropbox/callback

# Google Drive OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://clients.example.com/storage/google/callback

################
# Stripe (LIVE)
################
STRIPE_KEY=pk_live_REPLACE_ME
STRIPE_SECRET=sk_live_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

##############################
# Monitoring / Error Tracking
##############################
# Sentry (optional)
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Bugsnag (optional)
BUGSNAG_API_KEY=

# New Relic / DataDog are usually configured at the host/agent level.

#################
# App Healthcheck
#################
# `/up` route is enabled by default in Laravel 11 bootstrap/app.php.

