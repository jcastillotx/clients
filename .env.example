APP_NAME="Kre8iv Designs Client Portal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/New_York
APP_URL=https://clients.kre8ivdesigns.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kre8iv_clients
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Security: CORS and Proxy Configuration
# CORS_ALLOWED_ORIGINS: Comma-separated list of allowed origins (* allows all)
CORS_ALLOWED_ORIGINS=*
# TRUSTED_PROXIES: Set to * if behind Cloudflare/CDN, or specify IPs (e.g., 10.0.0.1,10.0.0.2)
TRUSTED_PROXIES=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mail.kre8ivdesigns.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="noreply@kre8ivdesigns.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Stripe Payment Gateway
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Application Settings
CLIENT_PORTAL_SUPPORT_EMAIL=support@kre8ivdesigns.com
CLIENT_PORTAL_MAX_UPLOAD_SIZE=10240
CLIENT_PORTAL_ALLOWED_FILE_TYPES=pdf,doc,docx,xls,xlsx,png,jpg,jpeg,gif,zip

# Invoice Settings
INVOICE_PREFIX=INV-
INVOICE_TAX_RATE=0
INVOICE_COMPANY_NAME="Kre8iv Designs LLC"
INVOICE_COMPANY_ADDRESS="Your Company Address"
INVOICE_COMPANY_EMAIL="billing@kre8ivdesigns.com"
INVOICE_COMPANY_PHONE="(555) 123-4567"

# Brand Monitoring - Free/Low-Cost APIs
# Get API keys from the free tiers of these services

# News Monitoring
NEWSAPI_ENABLED=true
NEWSAPI_API_KEY=
# Get free key at: https://newsapi.org (100 requests/day free)

GOOGLE_NEWS_RSS_ENABLED=true
# No API key needed - free unlimited

# Review Monitoring
YELP_API_ENABLED=true
YELP_API_KEY=
# Get free key at: https://www.yelp.com/developers (5000 requests/day free)

GOOGLE_PLACES_ENABLED=true
GOOGLE_PLACES_API_KEY=
# Get free key at: https://console.cloud.google.com ($200/month credit free)

# Social Media Monitoring
REDDIT_API_ENABLED=true
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=BrandMonitor/1.0
# Get free credentials at: https://www.reddit.com/prefs/apps (60 requests/min free)

YOUTUBE_API_ENABLED=true
YOUTUBE_API_KEY=
# Get free key at: https://console.cloud.google.com (10,000 quota units/day free)

TWITTER_RSS_ENABLED=true
# No API key needed - uses Nitter RSS (free unlimited)

# Web Mention Monitoring
GOOGLE_SEARCH_ENABLED=true
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
# Get free API at: https://programmablesearchengine.google.com (100 searches/day free)

BING_SEARCH_ENABLED=true
BING_SEARCH_API_KEY=
# Get free key at: https://www.microsoft.com/en-us/bing/apis/bing-web-search-api (1000 searches/month free)

# RSS Feed Monitoring
RSS_MONITORING_ENABLED=true
RSS_CHECK_INTERVAL=60

# Sentiment Analysis (uses existing AI providers)
SENTIMENT_AI_PROVIDER=openai
SENTIMENT_AI_MODEL=gpt-4o-mini

# ============================================================================
# BRANDING & WHITE LABEL CONFIGURATION
# ============================================================================
# Customize the client portal appearance to match your brand
# See config/branding.php for all available options

# Company Information
BRAND_COMPANY_NAME="Kre8ivDesigns Marketing"
BRAND_LEGAL_NAME="Kre8ivDesigns Marketing, LLC"
BRAND_TAGLINE="Creating Awareness About Your Brand"
BRAND_PHONE="210-549-7907"
BRAND_EMAIL="info@kre8ivdesigns.com"
BRAND_SUPPORT_EMAIL="support@kre8ivdesigns.com"
BRAND_WEBSITE="https://www.kre8ivdesigns.com"
BRAND_ADDRESS="San Antonio, TX"

# Brand Colors (Update these with your actual brand colors from your website)
# Primary color - main brand color used in headers, buttons, links
BRAND_COLOR_PRIMARY="#2563eb"
# Primary dark - darker variant for hover states
BRAND_COLOR_PRIMARY_DARK="#1e40af"
# Primary light - lighter variant for backgrounds
BRAND_COLOR_PRIMARY_LIGHT="#dbeafe"
# Secondary/accent color
BRAND_COLOR_SECONDARY="#10b981"
# Accent color for CTAs and highlights
BRAND_COLOR_ACCENT="#f59e0b"

# Text Colors
BRAND_COLOR_TEXT_PRIMARY="#1f2937"
BRAND_COLOR_TEXT_SECONDARY="#6b7280"

# Background Colors
BRAND_COLOR_BACKGROUND="#ffffff"
BRAND_COLOR_BACKGROUND_ALT="#f9fafb"

# Status Colors (optional - uncomment to override defaults)
# BRAND_COLOR_SUCCESS="#10b981"
# BRAND_COLOR_WARNING="#f59e0b"
# BRAND_COLOR_DANGER="#ef4444"
# BRAND_COLOR_INFO="#3b82f6"

# Typography
# Google Fonts to load (e.g., "Inter:300,400,500,600,700" or "Roboto:400,500,700")
BRAND_GOOGLE_FONTS="Inter:300,400,500,600,700"
BRAND_FONT_PRIMARY="Inter, system-ui, -apple-system, sans-serif"
BRAND_FONT_SECONDARY="Inter, system-ui, -apple-system, sans-serif"

# Logo & Images
# Place logo files in public/images/ directory
BRAND_LOGO_MAIN="images/logo.png"
BRAND_LOGO_DARK="images/logo-white.png"
BRAND_LOGO_ICON="images/icon.png"
BRAND_LOGO_WIDTH=200
BRAND_LOGO_HEIGHT=50
BRAND_FAVICON="favicon.ico"

# Design Elements
BRAND_BORDER_RADIUS="0.5rem"
BRAND_BORDER_RADIUS_LG="1rem"
BRAND_BORDER_RADIUS_SM="0.25rem"
BRAND_BUTTON_STYLE="rounded"
BRAND_USE_GRADIENTS=false

# Login/Auth Page
BRAND_AUTH_BG_STYLE="gradient"
BRAND_AUTH_WELCOME="Welcome to Your Client Portal"

# Social Media (optional)
# BRAND_SOCIAL_FACEBOOK=
# BRAND_SOCIAL_TWITTER=
# BRAND_SOCIAL_LINKEDIN=
# BRAND_SOCIAL_INSTAGRAM=
# BRAND_SOCIAL_YOUTUBE=
