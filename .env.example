APP_NAME="Kre8iv Designs Client Portal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/New_York
APP_URL=https://clients.kre8ivdesigns.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kre8iv_clients
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Security: CORS and Proxy Configuration
# CORS_ALLOWED_ORIGINS: Comma-separated list of allowed origins (* allows all)
CORS_ALLOWED_ORIGINS=*
# TRUSTED_PROXIES: Set to * if behind Cloudflare/CDN, or specify IPs (e.g., 10.0.0.1,10.0.0.2)
TRUSTED_PROXIES=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mail.kre8ivdesigns.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="noreply@kre8ivdesigns.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Stripe Payment Gateway
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Application Settings
CLIENT_PORTAL_SUPPORT_EMAIL=support@kre8ivdesigns.com
CLIENT_PORTAL_MAX_UPLOAD_SIZE=10240
CLIENT_PORTAL_ALLOWED_FILE_TYPES=pdf,doc,docx,xls,xlsx,png,jpg,jpeg,gif,zip

# Invoice Settings
INVOICE_PREFIX=INV-
INVOICE_TAX_RATE=0
INVOICE_COMPANY_NAME="Kre8iv Designs LLC"
INVOICE_COMPANY_ADDRESS="Your Company Address"
INVOICE_COMPANY_EMAIL="billing@kre8ivdesigns.com"
INVOICE_COMPANY_PHONE="(555) 123-4567"
